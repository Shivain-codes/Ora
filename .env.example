# Server only. Atlas user must have ONLY the built-in read role on sample_mflix.
MONGODB_URI=
NIM_API_KEY=
PORT=3001
# Public frontend config. Leave empty for the same-origin /api proxy.
# If set, include /api, e.g. https://askmongo.example.com/api
VITE_API_URL=
# Optional server-only model override; check availability in your NVIDIA account.
NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
